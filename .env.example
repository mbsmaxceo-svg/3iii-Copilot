# 3iii-Copilot environment variables
# Copy this file to .env and fill in local values. Never commit .env.

# Supabase client configuration (public client credentials; enforce access with RLS)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Supabase Auth providers
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GITHUB_CLIENT_ID=
GITHUB_SECRET=
AZURE_CLIENT_ID=
AZURE_SECRET=
AZURE_TENANT_ID=

# AI provider keys (keep server-side; do not bundle in the mobile app)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional S3-compatible storage
S3_HOST=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
