{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "3iii-Copilot project export",
  "description": "Proposed validation schema for the .3iii context export format described in docs/PRD.md. Version 1.0 defines the top-level structure and core interoperable fields; optional additional fields are allowed for forward compatibility.",
  "type": "object",
  "required": [
    "version",
    "metadata",
    "project",
    "chat",
    "tasks",
    "context",
    "references"
  ],
  "properties": {
    "version": {
      "const": "1.0",
      "description": "Format version."
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "chat": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chatMessage"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "context": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contextItem"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "metadata": {
      "type": "object",
      "properties": {
        "exported_at": {
          "type": "string",
          "format": "date-time"
        },
        "app_version": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "chatMessage": {
      "type": "object",
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ]
        },
        "content": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "provider": {
          "type": "string",
          "enum": [
            "3iii-copilot",
            "openai",
            "anthropic",
            "google"
          ]
        },
        "name": {
          "type": "string",
          "description": "Optional tool name when role is tool."
        }
      },
      "additionalProperties": true
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "todo",
            "in_progress",
            "blocked",
            "done",
            "cancelled"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "contextItem": {
      "type": "object",
      "required": [
        "type",
        "content"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Context kind, for example note, file, decision, or instruction."
        },
        "content": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "reference": {
      "type": "object",
      "required": [
        "type",
        "uri"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Reference kind, for example url, file, github_issue, or github_pull_request."
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
